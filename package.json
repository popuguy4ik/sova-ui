{
  "name": "sova-ui",
  "version": "1.0.0",
  "description": "Sova UI: дизайн-система продуктов мессенджера «Сова»",
  "scripts": {
    "tokens": "node style-dictionary.config.js",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build",
    "deploy-storybook": "gh-pages -t -d storybook-static -m \"Публикация Storybook\"",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "author": "Гугучкин Илья Евгеньевич",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/html-vite": "^10.6.7",
    "chromatic": "^18.14.4",
    "gh-pages": "^6.3.0",
    "storybook": "^10.6.7",
    "style-dictionary": "^5.8.0",
    "vite": "^8.3.8"
  },
  "private": false,
  "homepage": "https://popuguy4ik.github.io/sova-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/popuguy4ik/sova-ui.git"
  }
}